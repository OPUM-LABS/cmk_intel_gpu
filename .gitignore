# ==============================================================================
# Git Ignore Rules for cmk_intel_gpu
# ==============================================================================

# macOS metadata & system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# Editor & IDE configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Build & packaging artifacts (preserve .mkp release packages in dist/)
build/
*.egg-info/
.eggs/

# Logs & temporary runtime files
*.log
*.tmp
*err.*
scratch/
